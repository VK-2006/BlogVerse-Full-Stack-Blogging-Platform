NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/blogverse_db"
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Production email delivery through the Resend HTTPS API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_TIMEOUT_MS=10000

# Sender address. onboarding@resend.dev is only for initial testing.
# Use a verified-domain address for real users, for example reset@yourdomain.com.
EMAIL_FROM="BlogVerse <onboarding@resend.dev>"

# Optional SMTP fallback settings for password-reset and administrator support-reply emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Displayed as the primary BlogVerse founder/creator name
PROJECT_CREATOR_NAME="Venkat Kiran"

ALLOW_RESET_LINK_RESPONSE=false
