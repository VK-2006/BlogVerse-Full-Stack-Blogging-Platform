NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/blogverse_db"
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Brevo transactional email API (used for password-reset OTP and support replies)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=BlogVerse
BREVO_REPLY_TO_EMAIL=your-support-email@example.com
BREVO_REPLY_TO_NAME=BlogVerse Support
BREVO_TIMEOUT_MS=12000
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_SESSION_MINUTES=10

# Cloudinary persistent uploads (required for production file uploads on Render)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Seed controls. In production, set a strong secret before deliberately running npm run seed.
PROJECT_CREATOR_NAME="Venkat Kiran"
SEED_ADMIN_PASSWORD="replace-with-a-strong-production-admin-password"
SEED_WRITER_PASSWORD="Writer@123"
