NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/blogverse_db"
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Optional SMTP settings for password-reset and administrator support-reply emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="BlogVerse <your_email@gmail.com>"

# Displayed as the primary BlogVerse founder/creator name
PROJECT_CREATOR_NAME="Venkat Kiran"
